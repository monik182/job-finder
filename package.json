{
  "name": "job-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm src/index.ts",
    "start:worldwide-engineering": "node --loader ts-node/esm src/worldwide-engineering.ts",
    "dev:worldwide-engineering": "NODE_ENV=development node --loader ts-node/esm --env-file=.env src/worldwide-engineering.ts",
    "dev": "NODE_ENV=development node --loader ts-node/esm --env-file=.env src/index.ts",
    "dev:headed": "NODE_ENV=development HEADED=true node --loader ts-node/esm --env-file=.env src/index.ts",
    "dev:anywhere-remote": "NODE_ENV=development node --loader ts-node/esm --env-file=.env src/index.ts --source=anywhere-remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "puppeteer-core": "^22.15.0",
    "resend": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
